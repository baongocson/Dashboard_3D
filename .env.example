# Templates only, never put real secrets here.
# The API connects to MongoDB only when MONGODB_URI is set (then MONGODB_DB_NAME and a
# SESSION_SECRET of at least 32 characters are required). Without it, account routes answer 503.
MONGODB_URI=<backend-only-uri>
MONGODB_DB_NAME=<database-name>
SESSION_SECRET=<backend-only-secret>
PORT=3001
WEB_ORIGIN=http://localhost:4173
VITE_API_BASE_URL=http://localhost:3001
# Optional: MongoDB for apps/api/src/modules/auth/mongo.integration.test.ts.
# Without MONGODB_TEST_DB_NAME a temporary database is created and dropped.
# With it (Atlas user limited to readWrite on one database), only this run's test users are deleted.
# MONGODB_TEST_URI=<test-only-uri>
# MONGODB_TEST_DB_NAME=dashboard_dev
